{
  "name": "react-slot-engine-z",
  "version": "2.1.0",
  "description": "Lightweight slot & plugin engine for extensible React UI composition.",
  "license": "MIT",
  "author": "Delpi.Kye",
  "sideEffects": false,
  "main": "build/index.cjs",
  "module": "build/index.esm.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.esm.js",
      "require": "./build/index.cjs"
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "clean": "rimraf build",
    "build": "rollup -c",
    "cb": "npm run clean && npm run build",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/delpikye-v/react-slot-engine.git"
  },
  "homepage": "https://github.com/delpikye-v/react-slot-engine#readme",
  "bugs": {
    "url": "https://github.com/delpikye-v/react-slot-engine/issues"
  },
  "keywords": [
    "react",
    "react 18",
    "react library",
    "slot",
    "react slots",
    "slot engine",
    "plugin system",
    "plugin architecture",
    "ui composition",
    "layout system",
    "extensible ui",
    "modular ui",
    "dynamic layout",
    "micro frontend",
    "feature isolation",
    "react architecture",
    "design system",
    "headless ui"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^17.1.0",
    "@rollup/plugin-node-resolve": "^11.2.1",
    "@types/react": "^18.0.2",
    "rimraf": "^3.0.2",
    "rollup": "^2.56.3",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-typescript2": "^0.29.0",
    "tslib": "^2.3.1",
    "typescript": "^5.9.3"
  }
}
